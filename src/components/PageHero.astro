---
// Inner-page hero. With `tooth`, a 3D veneer turns beside the copy.
interface Props {
  eyebrow: string;
  title: string; // HTML, so a word can be wrapped in <span class="cyan">
  lede: string;
  tooth?: "porcelain" | "composite";
  glow?: "cyan" | "pink";
}
const { eyebrow, title, lede, tooth, glow = "cyan" } = Astro.props;
---

<section class:list={["hero pad", `glow-${glow}`, { split: tooth }]}>
  <div class="copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    <p class="lede">{lede}</p>
    <slot />
  </div>
  {tooth && <div class="stage" data-stage><canvas data-tooth={tooth}></canvas></div>}
</section>

<style>
  .hero { padding-top: 160px; padding-bottom: 60px; }
  .glow-cyan { background: radial-gradient(60% 60% at 70% 20%, rgba(69, 193, 238, 0.22), transparent 70%); }
  .glow-pink { background: radial-gradient(50% 60% at 85% 20%, rgba(232, 46, 137, 0.18), transparent 70%); }
  .copy { display: flex; flex-direction: column; gap: 26px; }
  .copy .eyebrow { margin: 0; }
  h1 { max-width: 1100px; font: 800 clamp(56px, 9vw, 140px)/0.84 var(--display); letter-spacing: -0.055em; font-stretch: 76%; }
  .lede { max-width: 560px; }

  .split {
    min-height: 100vh;
    padding-top: 140px;
    padding-bottom: 80px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 40px;
    align-items: center;
  }
  .split h1 { font-size: clamp(56px, 8vw, 120px); line-height: 0.86; letter-spacing: -0.05em; }
  .split.glow-cyan {
    background: radial-gradient(60% 70% at 80% 40%, rgba(69, 193, 238, 0.24), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgba(232, 46, 137, 0.16), transparent 70%);
  }
  .split.glow-pink {
    background: radial-gradient(60% 70% at 80% 40%, rgba(232, 46, 137, 0.22), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgba(69, 193, 238, 0.16), transparent 70%);
  }
  .stage { position: relative; height: min(70vh, 620px); }
</style>
