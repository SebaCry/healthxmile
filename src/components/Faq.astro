---
interface Props {
  items: [string, string][];
  heading?: string;
}
const { items, heading = "Questions patients ask" } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map(([q, a]) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<section class="band">
  <div class="shell faq">
    <h2>{heading}</h2>
    <div>
      {items.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .faq { grid-template-columns: 20rem minmax(0, 1fr); }
    .faq h2 { position: sticky; top: 6rem; }
  }
  details {
    border-top: 1px solid var(--line);
    padding: 1.1rem 0;
  }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    color: var(--cyan);
    font-size: 1.4rem;
    line-height: 1;
  }
  details[open] summary::after { content: "–"; }
  details p { margin: 0.8rem 0 0; color: var(--ink-soft); }
</style>
