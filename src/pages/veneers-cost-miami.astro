---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import { price } from "../site";

const faq: [string, string][] = [
  [
    "Does insurance cover veneers?",
    "Most dental plans don't cover purely cosmetic treatment. If part of your case is restorative, partial coverage may apply. We verify your benefits at no charge.",
  ],
  [
    "Can the price change once treatment starts?",
    "Only if there's decay, gum disease or a need for prior treatment. That's quoted separately and disclosed before we begin, never mid-treatment.",
  ],
  [
    "Is the lab fee extra?",
    "No. Diagnosis, design, trial smile, temporaries, placement, bite adjustment and follow-ups are all included in the quoted price.",
  ],
  [
    "How does financing work?",
    `We work with ${price.lender}, with plans from ${price.monthly} a month. Approval takes minutes and can be done online before your visit.`,
  ],
];
---

<Base
  title="How Much Do Veneers Cost in Miami? 2026 Pricing – Healthy Xmile"
  description="Real pricing for porcelain and composite veneers in Miami. Per-tooth cost, full cases, what's included, and financing plans. No hidden lab fees."
  path="/veneers-cost-miami"
>
  <PageHero
    eyebrow="Veneers cost · Miami"
    title="What veneers cost in Miami"
    lede="Clear prices per tooth and per full case, published before you book. Lab fees are included."
    glow="pink"
  />

  <section class="pad price-sec">
    <div class="tbl wrap">
      <table>
        <thead>
          <tr><th scope="col">Option</th><th scope="col">Per tooth</th><th scope="col">Full case, 8 teeth</th><th scope="col">Time</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Composite veneers</th><td class="big cyan">from {price.compositeTooth}</td><td class="big">from {price.compositeCase}</td><td>1 visit</td></tr>
          <tr><th scope="row">Porcelain veneers</th><td class="big cyan">from {price.porcelainTooth}</td><td class="big">from {price.porcelainCase}</td><td>2–3 weeks</td></tr>
          <tr><th scope="row">Consultation &amp; preview</th><td colspan="3" class="big">{price.consultation}<span class="credit">credited toward treatment</span></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="pad split center fin">
    <div class="arch-card">
      <p class="eyebrow">Financing</p>
      <p class="monthly">{price.monthly}<span>/month</span></p>
      <p class="lede">Payment plans through {price.lender}. Approval takes minutes and can be done online before your visit.</p>
    </div>
    <div class="quote">
      <h2 class="h-l">Your exact quote comes with your preview.</h2>
      <a class="btn" href="/contact">Book your consultation</a>
    </div>
  </section>

  <section class="sec pad split">
    <div class="prose">
      <h2>What's included</h2>
      <p>
        Diagnosis, photography, digital design, trial smile, temporaries, placement, bite adjustment
        and follow-ups. We don't charge separately for design or lab work.
      </p>
    </div>
    <div class="prose">
      <h3>What can change the price</h3>
      <p>
        If there's decay, gum disease or a need for prior treatment, it's quoted separately and
        disclosed before we begin. Never mid-treatment.
      </p>
      <h3>Insurance</h3>
      <p>
        Most dental plans don't cover purely cosmetic treatment. If part of your case is restorative,
        partial coverage may apply. We verify your benefits at no charge.
      </p>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  .price-sec { padding-block: 20px 60px; }
  .credit { display: block; margin-top: 8px; font: 400 15px/1.4 var(--body); color: var(--muted); }
  .fin { padding-block: 20px clamp(60px, 8vw, 110px); }
  .monthly { font: 800 clamp(56px, 6vw, 96px)/0.85 var(--display); letter-spacing: -0.05em; font-stretch: 78%; }
  .monthly span { font-size: 0.4em; font-weight: 500; letter-spacing: -0.02em; }
  .quote { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
</style>
