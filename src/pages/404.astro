---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Healthy Xmile Miami"
  description="That page doesn't exist. Find veneers, smile design and pricing information here."
  path="/404"
>
  <section class="lost">
    <div class="big" aria-hidden="true">
      <span>4</span>
      <div class="stage" data-stage><canvas data-tooth="porcelain" data-lost></canvas></div>
      <span>4</span>
    </div>
    <h1>This tooth wandered off.</h1>
    <p class="lede">The page you’re looking for isn’t here. The rest of the smile is.</p>
    <a class="btn" href="/">Back to home</a>
  </section>
</Base>

<style>
  .lost {
    min-height: 100vh; padding: 140px 20px 80px; text-align: center;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(69, 193, 238, 0.2), transparent 70%);
  }
  .big { display: flex; align-items: center; justify-content: center; font: 800 clamp(140px, 26vw, 360px)/0.8 var(--display); letter-spacing: -0.06em; font-stretch: 76%; }
  .stage { position: relative; width: clamp(120px, 22vw, 300px); height: clamp(160px, 28vw, 380px); }
  .stage canvas { inset: -30%; width: 160%; height: 160%; }
  h1 { font: 700 clamp(32px, 4vw, 56px)/1 var(--display); letter-spacing: -0.04em; }
  .lede { max-width: 440px; }
</style>
