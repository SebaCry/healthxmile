---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import { price } from "../site";

const faq: [string, string][] = [
  [
    "Will you shave down my teeth?",
    "In most cases a very thin layer of enamel is removed, usually 0.3 to 0.7 mm. In some cases — small, worn or spaced teeth — no-prep veneers are possible. We tell you which case is yours at the consultation.",
  ],
  [
    "How long do porcelain veneers last?",
    "Ten to twenty years with proper care. What shortens their life is usually grinding without a night guard or biting hard objects, not the material itself.",
  ],
  [
    "What if one breaks?",
    "Porcelain is replaced, just that unit, not the whole case. Our veneers carry a warranty against fracture from material defect.",
  ],
  [
    "Do I need whitening first?",
    "If you're only treating some teeth, yes: whitening comes first, then two weeks of settling, because veneers won't change shade afterward. If you're treating the whole smile, no.",
  ],
  [
    "Does insurance cover veneers?",
    "Usually not, since they're considered cosmetic. If part of your treatment is restorative, partial coverage may apply. We verify your benefits at no charge.",
  ],
];
---

<Base
  title="Porcelain Veneers in Miami | Cost, Process & How Long They Last"
  description="Custom porcelain veneers in Miami. The full process, how long they last, what they cost and whether you're a candidate. Digital preview included. Book today."
  path="/porcelain-veneers-miami"
>
  <PageHero
    eyebrow="Porcelain veneers · Miami"
    title="Porcelain veneers in Miami"
    lede="Thin glass-ceramic shells made by the lab from your digital design, bonded over the front of your teeth. The most lifelike option we offer."
    tooth="porcelain"
  >
    <div class="actions">
      <a class="btn" href="/contact">Book your consultation</a>
      <a class="btn ghost" href="/veneers-cost-miami">See pricing</a>
    </div>
  </PageHero>

  <section class="sec pad stats">
    <div class="stat"><b class="cyan">0.3–0.7</b><span>mm of enamel, only where needed</span></div>
    <div class="stat"><b>2–3</b><span>weeks from preparation to placement</span></div>
    <div class="stat"><b>{price.porcelainTooth}</b><span>per tooth, lab fees included</span></div>
    <div class="stat"><b class="pink">Preview</b><span>on your own face before we begin</span></div>
  </section>

  <section class="sec pad split center">
    <img class="arch" src="/img/veneers-closeup.webp" width="900" height="1125" alt="Close-up of a smile restored with porcelain veneers" loading="lazy" />
    <div class="steps">
      <h2 class="h-l">How it goes</h2>
      <div class="step"><span>01</span><p><strong>Design visit.</strong> Scan, photos and your digital preview. Then a trial smile in temporary material, so you can see it, speak with it and ask for changes.</p></div>
      <div class="step"><span>02</span><p><strong>Preparation.</strong> A thin layer of enamel, then temporaries that follow the approved design.</p></div>
      <div class="step"><span>03</span><p><strong>Placement.</strong> 2–3 weeks later the lab’s veneers are tried in, bonded, adjusted to your bite and polished.</p></div>
      <div class="step"><span>04</span><p><strong>Follow-up.</strong> A check-up after placement, and again a few months later.</p></div>
    </div>
  </section>

  <section class="sec pad split">
    <div class="prose">
      <h2>What porcelain fixes</h2>
      <p>
        Porcelain veneers are the most predictable cosmetic dental treatment available today, and
        also the one most often done badly. The difference between a veneer you notice and one you
        don't comes from the design work and the ceramist's hand, not the brand of the material.
      </p>
      <ul>
        <li>Stains that don't respond to whitening</li>
        <li>Teeth worn down by grinding or age</li>
        <li>Gaps between teeth</li>
        <li>Chipped or fractured teeth</li>
        <li>Small or disproportionate teeth</li>
        <li>Mild crowding, without braces</li>
        <li>Uneven smile lines</li>
      </ul>
      <p class="note">
        What they don't fix: severe crowding, significant bite problems, active gum disease or
        untreated decay. Those come first, and we'll tell you so at the consultation.
      </p>
    </div>
    <div class="prose">
      <h2>Will you shave down my teeth?</h2>
      <p>It's the question we get most, and it deserves a straight answer.</p>
      <p>
        In most cases yes, a very thin layer of enamel is removed, usually between 0.3 and 0.7
        millimeters. That's less than the thickness of a fingernail, and it's done so the veneer
        doesn't look bulky and so the bond lasts.
      </p>
      <p>
        In some cases — small, worn or spaced teeth — no-prep or minimal-prep veneers are possible.
        It isn't a technique that works for everyone: it depends on the position and size of your
        teeth, not on what an ad promises.
      </p>
      <p>At your consultation we tell you which case is yours, with your photographs in front of you.</p>
    </div>
  </section>

  <section class="sec pad split">
    <div class="prose">
      <h2>How long they last</h2>
      <p>
        Ten to twenty years with proper care, and there are documented cases well beyond that. What
        shortens their life isn't the material, it's habit: grinding without a night guard, opening
        things with your teeth, chewing ice.
      </p>
      <h3>Care</h3>
      <ul>
        <li>Normal brushing, three times a day, with a non-abrasive paste</li>
        <li>Floss daily</li>
        <li>A night guard if you clench while sleeping</li>
        <li>Professional cleaning every six months</li>
        <li>Porcelain doesn't stain, but your gums and neighboring teeth do</li>
      </ul>
      <p>You don't need special toothpaste or unusual brushes. You need consistency.</p>
    </div>
    <div class="prose">
      <h2>Cost in Miami</h2>
      <p>
        At Healthy Xmile, porcelain veneers start at {price.porcelainTooth} per tooth, and a full case
        of eight to ten veneers starts at {price.porcelainCase}.
      </p>
      <p>
        Included: diagnosis, digital design, trial smile, temporaries, placement and follow-ups. No
        separate design or lab charge.
      </p>
      <p>Financing available from {price.monthly} a month through {price.lender}.</p>
      <p><a class="link" href="/veneers-cost-miami">See full pricing and payment plans</a></p>
    </div>
  </section>

  <Faq items={faq} />

  <section class="cta">
    <h2>Find out if porcelain is right for <span class="cyan">your case</span></h2>
    <p class="lede">Bring your questions. We'll take photographs, show you a preview and give you a written plan with pricing.</p>
    <div class="actions">
      <a class="btn" href="/contact">Book your consultation</a>
      <a class="btn ghost" href="/composite-veneers-miami">Compare with composite</a>
    </div>
  </section>
</Base>
