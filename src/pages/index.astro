---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import { clinic, price } from "../site";

const facts = [
  ["Smiles designed in Miami", "[N]", "smile"],
  ["Digital preview", "Before treatment begins", "scan-face"],
  ["Lab fees", "Included, never added later", "receipt"],
  ["Payment plans", `From ${price.monthly} a month`, "wallet"],
];

const faq: [string, string][] = [
  [
    "Does getting veneers hurt?",
    "No. We use local anesthesia when preparation is involved, and no-prep composite veneers usually don't need it at all. Some cold sensitivity in the first few days is normal and resolves on its own.",
  ],
  [
    "Will you shave down my teeth?",
    "With porcelain, a thin layer of enamel is usually removed, 0.3 to 0.7 mm. In some cases it can be avoided entirely. We tell you which applies to you at your consultation, with your photos in hand.",
  ],
  [
    "How long does the whole thing take?",
    "Composite veneers are done in one visit. Porcelain takes 2 to 3 weeks across 3 or 4 appointments.",
  ],
  [
    "Will they look fake?",
    "Only if they're badly designed. A natural veneer has surface texture, translucency at the edge and a slight intentional asymmetry. Shade is chosen against your skin, your eyes and your age, not against the whitest tab available.",
  ],
];
---

<Base
  title="Smile Design in Miami | Porcelain & Composite Veneers – Healthy Xmile"
  description="Custom porcelain and composite veneers in Miami. See a digital preview of your new smile before we touch a single tooth. Transparent pricing. Book a consultation."
  path="/"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <h1>A smile designed for your face, not from a catalog</h1>
        <p class="lede">
          We don't work from a template. We study your proportions, your bite and the way your
          lip moves when you talk, then design porcelain or composite veneers that still look
          like you.
        </p>
        <div class="actions">
          <a class="btn" href="/contact">Book your consultation</a>
          <a class="btn btn-quiet" href="/smile-design">See how it works</a>
        </div>
        <div class="hero-meta">
          <p class="line"><Icon name="languages" />English and Spanish spoken</p>
          <p class="line"><Icon name="map-pin" />{clinic.street}, {clinic.city}, {clinic.region} {clinic.zip}</p>
          <p class="line"><Icon name="phone" />{clinic.phone}</p>
        </div>
      </div>
      <figure class="arch">
        <img
          src="/img/hero-smile.webp"
          width="1000"
          height="1500"
          alt="Close-up of a patient smiling after veneer treatment"
          fetchpriority="high"
        />
        <span class="badge b1" aria-hidden="true"><Icon name="sparkles" /></span>
        <span class="badge b2" aria-hidden="true"><Icon name="smile" /></span>
      </figure>
    </div>
  </section>

  <section class="band facts-band">
    <div class="shell">
      <dl class="facts">
        {facts.map(([label, value, icon]) => (
          <div class="has-ico">
            <Icon name={icon} tile />
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <h2>We do one thing</h2>
      <p class="lede">
        Healthy Xmile is not a general dental office. We focus on anterior cosmetic dentistry:
        porcelain veneers, composite veneers, and the design work that holds them together.
        That focus is why our cases look natural.
      </p>
      <ul class="rule-list services">
        <li class="has-ico">
          <Icon name="gem" tile />
          <h3>Porcelain veneers</h3>
          <p>
            Thin ceramic shells that correct shape, color and apparent position. Stain
            resistant, 10 to 20 years with proper care, and they bring back the translucency of
            natural enamel.
          </p>
          <a href="/porcelain-veneers-miami">Porcelain veneers</a>
        </li>
        <li class="has-ico">
          <Icon name="paintbrush" tile />
          <h3>Composite veneers</h3>
          <p>
            Sculpted directly onto the tooth in a single visit. Lower cost, often reversible,
            and adjustable later. A good fit for targeted corrections, or for testing a change
            before committing.
          </p>
          <a href="/composite-veneers-miami">Composite veneers</a>
        </li>
        <li class="has-ico">
          <Icon name="sparkles" tile />
          <h3>Smile design</h3>
          <p>
            The full plan: facial analysis, photography, digital preview and a trial smile in
            your mouth before anything is final.
          </p>
          <a href="/smile-design">How smile design works</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band process">
    <div class="shell process-grid">
      <div>
        <h2>How it works</h2>
        <p class="lede">Five visits, and you approve the result before anything permanent is made.</p>
        <img class="process-img" src="/img/dentist-at-work.webp" width="900" height="600" alt="Dentist examining a patient in the treatment chair" loading="lazy" />
      </div>
      <ol class="steps">
        <li>
          <h3>Consultation</h3>
          <p>We examine your teeth, gums and bite, take photographs and scan. We tell you what's possible and what isn't, without overpromising.</p>
        </li>
        <li>
          <h3>Design and preview</h3>
          <p>We design your smile on your own photos. You review it, we adjust it. Nothing gets made until you're satisfied.</p>
        </li>
        <li>
          <h3>Trial smile</h3>
          <p>We place a temporary version over your teeth so you can see it move, talk, smile, and decide with real information.</p>
        </li>
        <li>
          <h3>Placement</h3>
          <p>We bond the final veneers, adjust your bite and polish. You leave with your smile finished that day.</p>
        </li>
        <li>
          <h3>Follow-up</h3>
          <p>A check-up shortly after placement, plus long-term follow-up and care instructions.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <h2>Why patients choose us</h2>
      <div class="reasons">
        <div class="has-ico">
          <Icon name="shield-check" tile />
          <h3>We say no when no is the right answer</h3>
          <p>If your teeth need something else before veneers, we tell you. A veneer over an unresolved problem is money wasted.</p>
        </div>
        <div class="has-ico">
          <Icon name="eye" tile />
          <h3>You see it before you commit</h3>
          <p>The digital preview isn't an upsell. It's part of the process, and it's included in the consultation.</p>
        </div>
        <div class="has-ico">
          <Icon name="badge-dollar-sign" tile />
          <h3>Fixed pricing</h3>
          <p>The estimate you sign is what you pay. Diagnosis, design, temporaries and follow-ups are in the price.</p>
        </div>
        <div class="has-ico">
          <Icon name="languages" tile />
          <h3>Fully bilingual</h3>
          <p>Consultation, treatment plan and follow-up in English or Spanish, whichever you prefer.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <section class="band cta-band">
    <div class="shell">
      <h2>Ready to see your new smile?</h2>
      <p class="lede">
        Your consultation includes an exam, photographs and a preliminary digital preview.
        No obligation.
      </p>
      <div class="actions">
        <a class="btn" href="/contact">Book your consultation</a>
        <a class="btn btn-quiet" href="/veneers-cost-miami">See pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) 0; }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; }
  }
  .hero-meta { margin-top: 2rem; color: var(--ink-soft); font-size: 0.98rem; }
  .hero-meta .line { margin-bottom: 0.4rem; }

  .arch { margin: 0; position: relative; }
  .arch::before {
    content: "";
    position: absolute;
    inset: -1.2rem -1.2rem 0;
    border: 1.5px solid var(--cyan);
    border-bottom: none;
    border-radius: var(--arch);
  }
  .arch img {
    position: relative;
    border-radius: var(--arch);
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: min(68vh, 34rem);
    object-fit: cover;
    object-position: 50% 62%;
    animation: clip-up 1.3s cubic-bezier(0.22, 0.75, 0.3, 1) 0.15s both;
  }
  .arch::before { animation: outline-in 1.2s cubic-bezier(0.22, 0.75, 0.3, 1) 0.5s both, float 7s ease-in-out 1.7s infinite; }
  @keyframes outline-in { from { opacity: 0; scale: 0.88; } }
  @keyframes float { 50% { translate: 0 -0.7rem; } }
  .badge {
    position: absolute; z-index: 1; display: grid; place-items: center; border-radius: 50%; color: #fff;
    animation: pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) both, float 5s ease-in-out infinite;
  }
  .badge :global(svg) { width: 55%; height: 55%; }
  .b1 { width: 3.8rem; height: 3.8rem; right: -1rem; top: 14%; background: var(--pink); box-shadow: 0 12px 26px -8px rgba(232, 46, 137, 0.6); animation-delay: 1s, 1.8s; }
  .b2 { width: 3rem; height: 3rem; left: -1rem; bottom: 16%; background: var(--cyan); box-shadow: 0 12px 26px -8px rgba(69, 193, 238, 0.7); animation-delay: 1.2s, 2.6s; }
  @keyframes pop { from { opacity: 0; scale: 0; } }

  .facts-band { background: var(--blush); border-top: none; }
  .facts {
    margin: 0;
    display: grid;
    gap: 1.8rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  :global(.facts .has-ico:nth-child(n) > .tile) { --bg: #fff; } /* Icon's markup carries no scope attribute */
  .facts dt { color: var(--ink-soft); font-size: 0.95rem; }
  .facts dd {
    margin: 0.2rem 0 0;
    font-family: Gabarito, sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
  }

  .services li a { font-weight: 600; }
  .services p { margin-bottom: 0.6rem; }

  .process-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) {
    .process-grid { grid-template-columns: 0.9fr 1.1fr; }
  }
  .process-img {
    margin-top: 2rem;
    border-radius: 1rem;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .reasons {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    margin-top: 2.5rem;
  }
  .reasons h3 { font-size: 1.15rem; }
  .reasons p { color: var(--ink-soft); margin: 0; }
</style>
