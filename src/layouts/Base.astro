---
import { clinic, nav, pending } from "../site";

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;

const address = `${clinic.street}, ${clinic.city}, ${clinic.region} ${clinic.zip}`;
const tel = pending(clinic.phone) ? null : `tel:${clinic.phone.replace(/[^+\d]/g, "")}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: clinic.name,
  description:
    "Smile design practice in Miami specializing in porcelain and composite veneers.",
  url: clinic.domain,
  telephone: clinic.phone,
  priceRange: "$$$",
  image: `${clinic.domain}/img/office.webp`,
  address: {
    "@type": "PostalAddress",
    streetAddress: clinic.street,
    addressLocality: clinic.city,
    addressRegion: clinic.region,
    postalCode: clinic.zip,
    addressCountry: "US",
  },
  availableLanguage: ["en", "es"],
  areaServed: ["Miami", "Doral", "Hialeah", "Kendall", "Coral Gables", "Brickell"],
  medicalSpecialty: "CosmeticDentistry",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Porcelain veneers" } },
      { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Composite veneers" } },
      { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Smile design" } },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={clinic.domain + path} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={clinic.domain + "/img/hero-smile.webp"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gabarito:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      :root {
        --ink: #0b2138;
        --ink-soft: #4e6377;
        --paper: #ffffff;
        --mist: #edf7fb;
        --blush: #fdeff6;
        --cyan: #45c1ee;
        --pink: #e82e89;
        --line: #d7e6ee;
        --arch: 22rem 22rem 0 0;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Hanken Grotesk", system-ui, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: Gabarito, system-ui, sans-serif;
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin: 0 0 0.6em;
      }
      h1 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); }
      h2 { font-size: clamp(1.9rem, 3.8vw, 2.9rem); }
      h3 { font-size: clamp(1.2rem, 2vw, 1.45rem); }
      p { margin: 0 0 1.1rem; max-width: 62ch; }
      a { color: var(--pink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      img { max-width: 100%; height: auto; display: block; }
      :focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

      .shell { width: min(100% - 2.5rem, 68rem); margin-inline: auto; }
      .band { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
      .band + .band { border-top: 1px solid var(--line); }
      .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 46ch; }

      /* Wordmark, until the client sends the logo files */
      .mark { font-family: Gabarito, sans-serif; font-weight: 700; font-size: 1.05rem;
        letter-spacing: 0.04em; display: inline-flex; align-items: center; text-decoration: none; }
      .mark b { color: var(--cyan); border: 1.5px solid var(--cyan); padding: 0.1em 0.35em; font-weight: 700; }
      .mark i { color: var(--pink); font-style: normal; margin-inline: -0.12em; font-size: 1.3em; }
      .mark u { color: var(--pink); text-decoration: none; }

      .site-head {
        position: sticky; top: 0; z-index: 10; background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
      }
      .site-head .shell { display: flex; align-items: center; gap: 1.5rem; height: 4.5rem; }
      .site-nav { margin-left: auto; display: flex; gap: 1.6rem; }
      .site-nav a { color: var(--ink); text-decoration: none; font-size: 0.98rem; font-weight: 500; }
      .site-nav a:hover, .site-nav a[aria-current="page"] { color: var(--pink); }
      .btn {
        display: inline-block; background: var(--pink); color: #fff; text-decoration: none;
        font-weight: 600; padding: 0.7rem 1.3rem; border-radius: 999px; white-space: nowrap;
      }
      .btn:hover { background: #c81d73; }
      .btn-quiet { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
      .btn-quiet:hover { background: var(--mist); border-color: var(--cyan); }
      .menu { margin-left: auto; }
      .menu summary { list-style: none; cursor: pointer; font-weight: 600; padding: 0.4rem 0; }
      .menu summary::-webkit-details-marker { display: none; }
      .menu[open] .menu-list { display: grid; }
      .menu-list {
        display: none; position: absolute; left: 0; right: 0; background: var(--paper);
        border-bottom: 1px solid var(--line); padding: 1rem 1.25rem 1.5rem; gap: 0.9rem;
      }
      .menu-list a { color: var(--ink); text-decoration: none; font-weight: 500; }
      .menu-list .btn { color: #fff; justify-self: start; }

      .rule-list { list-style: none; margin: 0; padding: 0; }
      .rule-list li { border-top: 1px solid var(--line); padding: 1.6rem 0; }
      .rule-list li:last-child { border-bottom: 1px solid var(--line); }

      .steps { list-style: none; margin: 0; padding: 0; counter-reset: step; display: grid; gap: 1.6rem; }
      .steps li { counter-increment: step; padding-left: 3.4rem; position: relative; }
      .steps li::before {
        content: counter(step); position: absolute; left: 0; top: 0.1rem;
        width: 2.3rem; height: 2.3rem; border-radius: 50%; border: 1.5px solid var(--cyan);
        color: var(--cyan); font-family: Gabarito, sans-serif; font-weight: 600;
        display: grid; place-items: center;
      }
      .steps li::after {
        content: ""; position: absolute; left: 1.15rem; top: 2.6rem; bottom: -1.6rem;
        border-left: 1px dashed var(--line);
      }
      .steps li:last-child::after { display: none; }

      .prose { max-width: 62ch; }
      .prose h3 { margin-top: 2.4rem; }
      .prose ul { padding-left: 1.1rem; }
      .prose li { margin-bottom: 0.4rem; }
      .note { border-left: 2px solid var(--pink); padding-left: 1.3rem; }
      .note p:last-child { margin-bottom: 0; }

      .split { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1fr); align-items: start; }
      @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; } }
      .split img { border-radius: 1rem; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }

      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 0.9rem 0.6rem 0.9rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { font-weight: 600; }
      td + td, th + th { text-align: right; padding-right: 0; }
      .table-scroll { overflow-x: auto; }

      .cta-band { background: var(--mist); }
      .cta-band h2 { max-width: 18ch; }
      .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }

      .site-foot { background: var(--ink); color: #cfe0ea; padding-block: 3.5rem 2.5rem; }
      .site-foot a { color: #fff; }
      .site-foot h3 { color: #fff; font-size: 1rem; margin-bottom: 0.7rem; }
      .foot-grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
      .foot-grid ul { list-style: none; margin: 0; padding: 0; }
      .foot-grid li { margin-bottom: 0.4rem; }
      .foot-note { border-top: 1px solid #23415b; margin-top: 2.5rem; padding-top: 1.5rem;
        font-size: 0.9rem; color: #8fb0c6; }

      @media (max-width: 860px) {
        .site-nav, .head-cta { display: none; }
      }
      @media (min-width: 861px) {
        .menu { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="site-head">
      <div class="shell">
        <a class="mark" href="/"><b>HEALTHY</b><i>X</i><u>MILE</u></a>
        <nav class="site-nav">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <a class="btn head-cta" href="/contact">Book a consultation</a>
        <details class="menu">
          <summary>Menu</summary>
          <div class="menu-list">
            {nav.map(([href, label]) => <a href={href}>{label}</a>)}
            <a class="btn" href="/contact">Book a consultation</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="shell">
        <div class="foot-grid">
          <div>
            <a class="mark" href="/"><b>HEALTHY</b><i>X</i><u>MILE</u></a>
            <p style="margin-top:1rem">{clinic.tagline}</p>
          </div>
          <div>
            <h3>Visit us</h3>
            <p>{address}</p>
            <p>
              {tel ? <a href={tel}>{clinic.phone}</a> : clinic.phone}<br />
              WhatsApp {clinic.whatsapp}<br />
              {clinic.email}
            </p>
          </div>
          <div>
            <h3>Hours</h3>
            <ul>
              {clinic.hours.map(([day, time]) => <li>{day}: {time}</li>)}
            </ul>
          </div>
          <div>
            <h3>Treatments</h3>
            <ul>
              {nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
            </ul>
          </div>
        </div>
        <p class="foot-note">
          © {new Date().getFullYear()} {clinic.name}. Cosmetic dentistry in Miami, FL.
          We treat patients in English and Spanish.
        </p>
      </div>
    </footer>
  </body>
</html>
